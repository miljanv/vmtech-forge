# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3005
STUDIOFORGE_DEMO_MODE=true

# Neon PostgreSQL
# Pooled connection for the application
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
# Direct (unpooled) connection for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin

# Comma-separated admin emails (required in production)
ADMIN_EMAILS="owner@example.com"

# OpenAI (server-only — never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACTOR=gpt-5.6-terra
OPENAI_MODEL_DESIGNER=gpt-5.6
# Set to true only if you intentionally want OpenAI to store responses
OPENAI_STORE_RESPONSES=false

# Trigger.dev
TRIGGER_SECRET_KEY=
NEXT_PUBLIC_TRIGGER_PUBLIC_API_KEY=
TRIGGER_PROJECT_ID=

# Firecrawl (optional — native fetch/Cheerio/Playwright is used when missing)
FIRECRAWL_API_KEY=

# Cloudflare R2 (optional — local filesystem is used in development when missing)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Optional error tracking
SENTRY_DSN=

# Optional preview session hashing salt (a random value is generated in demo mode)
PREVIEW_SESSION_SALT=
